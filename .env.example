# Copy to .env. These match docker-compose.yml.
DATABASE_URL=postgres://campus:campus@localhost:5432/campus_walk
# Without Docker, use embedded Postgres instead:
# DATABASE_URL=pglite://.data/pg

# Set to "require" for RDS; leave unset locally.
# DATABASE_SSL=require
# The deployment sends the connection in parts instead (DB_HOST, DB_PORT, DB_NAME, and DB_USER /
# DB_PASSWORD from Secrets Manager); they are used only when DATABASE_URL is unset.
# SEED_ON_EMPTY=1 seeds the demo campus when the database has none (the deployment sets it).

# Photo storage. Locally this is RustFS (S3-compatible) with its own static keys; on AWS the
# task role supplies credentials, S3_ENDPOINT and the S3_* keys are left unset. Without
# S3_BUCKET photos are kept in memory and lost on restart.
S3_BUCKET=campus-walk-photos
S3_ENDPOINT=http://localhost:9000
# Presigned URLs are handed to the browser. With a loopback S3_ENDPOINT the API swaps in the
# host the request came from (so a phone on the LAN gets http://<laptop-ip>:9000). Set this
# only when that guess is wrong, e.g. behind a tunnel: S3_PUBLIC_ENDPOINT=https://s3.example.com
# S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=rustfs
S3_SECRET_ACCESS_KEY=rustfs12345
AWS_REGION=us-east-1

# Enabled only when BEDROCK_MODEL is set; it then uses the default AWS credential chain (env, profile,
# task role). Leave unset locally to get an empty suggestion instead.
# BEDROCK_MODEL=anthropic.claude-opus-5-5

# Tests run on in-memory PGlite by default. Point this at Postgres to run them there instead;
# each test file gets its own throwaway database.
# TEST_DATABASE_URL=postgres://campus:campus@localhost:5432/campus_walk
